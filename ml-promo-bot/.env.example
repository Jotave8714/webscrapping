# ---- WA-AKG (gateway WhatsApp) ----
WA_BASE_URL=http://localhost:3000
WA_API_KEY=wag_sua_chave_aqui
WA_SESSION_ID=minha-sessao
# JID do grupo (descubra com: python -m bot.main --list-groups)
WA_GROUP_JID=120363000000000000@g.us

# ---- Scraper Mercado Livre ----
# URLs separadas por virgula
ML_URLS=https://www.mercadolivre.com.br/ofertas
ML_MAX_PAGES=2
MIN_DISCOUNT=20
MAX_PER_RUN=10
HEADLESS=true
# Perfil persistente do navegador (guarda login/cookies)
BROWSER_PROFILE_DIR=./.browser-profile
# Tag de afiliado opcional (acrescentada aos links como ?matt_tool=...)
ML_AFFILIATE_PARAMS=

# ---- Loop ----
INTERVAL_MINUTES=30
DELAY_BETWEEN_MESSAGES=15
DB_PATH=./promos.db
